{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfferReadyPayload",
  "type": "object",
  "required": [
    "offer_id",
    "customer_id",
    "max_margin_safe_discount_pct",
    "max_discount_rupees",
    "scheduled_for",
    "favorite_dish_name"
  ],
  "additionalProperties": false,
  "properties": {
    "offer_id": { "type": "string", "format": "uuid" },
    "customer_id": { "type": "string", "format": "uuid" },
    "max_margin_safe_discount_pct": { "type": "number" },
    "max_discount_rupees": { "type": "number" },
    "scheduled_for": { "type": "string", "format": "date-time" },
    "favorite_dish_name": { "type": "string" },
    "decay_score": { "type": ["number", "null"] },
    "direct_order_url": { "type": "string", "format": "uri" }
  }
}
