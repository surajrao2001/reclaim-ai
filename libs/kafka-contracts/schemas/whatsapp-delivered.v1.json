{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WhatsappDeliveredPayload",
  "type": "object",
  "required": ["offer_id", "wa_message_id", "delivery_channel", "status"],
  "additionalProperties": false,
  "properties": {
    "offer_id": { "type": "string", "format": "uuid" },
    "wa_message_id": { "type": "string" },
    "delivery_channel": {
      "type": "string",
      "enum": ["meta_cloud_api", "gupshup_bsp"]
    },
    "status": {
      "type": "string",
      "enum": ["queued", "sent", "delivered", "read", "failed"]
    }
  }
}
