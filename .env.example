# ReclaimAI — local / shared non-secret defaults
# Copy to .env and fill secrets. Never commit real secrets.

NODE_ENV=development
CLAIM_WEB_BASE_URL=http://localhost:3101
DEFAULT_CASHBACK_AMOUNT_INR=100

# Data stores (docker-compose.dev.yml)
# Nest services use postgresql:// ; Python services may use postgresql+psycopg://
DATABASE_URL=postgresql://reclaimai:reclaimai_dev@localhost:5433/reclaimai
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=pos-integration-service

# Petpooja webhook HMAC (generate a strong local secret)
PETPOOJA_WEBHOOK_SECRET=dev_petpooja_hmac_secret_change_me

# Auth0 / OIDC (B2B dashboard) — fill when connecting Auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=

# Anthropic (Copy/LLM) — fill when implementing orchestrator
ANTHROPIC_API_KEY=

# RazorpayX — fill when implementing cashback payouts
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# WhatsApp dispatch (Nest :3003)
# WHATSAPP_MOCK defaults to true when META_WA_TOKEN is empty
WHATSAPP_MOCK=
WHATSAPP_SEND_MODE=text
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=dev_meta_wa_verify_token
META_WA_TEMPLATE_NAME=
META_WA_TEMPLATE_LANG=en
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg
KAFKA_GROUP_ID=whatsapp-dispatch-service

# Identity / claim flow
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:8001
CLAIM_JWT_SECRET=dev_claim_jwt_secret_change_me
PHONE_HASH_SECRET=dev_phone_hash_secret_change_me
CORS_ORIGINS=http://localhost:3101
SMTP_HOST=localhost
SMTP_PORT=1025

# Margin offer engine
KAFKA_CLIENT_ID=margin-offer-engine
KAFKA_ENABLED=true
OFFER_SCHEDULE_DELAY_HOURS=24

# Copy / LLM (optional — template used if empty)
ANTHROPIC_API_KEY=
