# ReclaimAI demo environment template
# Copy to .env.demo and replace placeholders before hosting publicly.

DEMO_HTTP_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088

NODE_ENV=production

POSTGRES_USER=reclaimai
POSTGRES_PASSWORD=reclaimai_demo_password
POSTGRES_DB=reclaimai

DATABASE_URL=postgresql://reclaimai:reclaimai_demo_password@postgres:5432/reclaimai
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

PETPOOJA_WEBHOOK_SECRET=change-me-demo-petpooja-secret
DEFAULT_CASHBACK_AMOUNT_INR=100
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800

CLAIM_JWT_SECRET=change-me-demo-claim-jwt-secret
PHONE_HASH_SECRET=change-me-demo-phone-hash-secret
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_FROM=otp@example.invalid

AUTH_DEV_BYPASS=true
AUTH_DEV_SECRET=change-me-demo-auth-secret
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.reclaimai.demo
AUTH0_JWKS_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
NEXT_PUBLIC_AUTH_DEV_BYPASS=true

RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=change-me-demo-razorpayx-webhook-secret
RAZORPAYX_MOCK=true
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1

WHATSAPP_MOCK=true
WHATSAPP_SEND_MODE=text
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=change-me-demo-meta-verify-token
META_WA_TEMPLATE_NAME=
META_WA_TEMPLATE_LANG=en
META_WA_API_VERSION=v21.0
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg
WHATSAPP_PROVIDER_TIMEOUT_MS=10000
DISPATCH_IDEMPOTENCY_TTL_SECONDS=1209600

ANTHROPIC_API_KEY=

KAFKA_ENABLED=true
OFFER_SCHEDULE_DELAY_HOURS=24
